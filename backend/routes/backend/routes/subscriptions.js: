const express = require("express");
const router = express.Router();
const stripe = require("stripe")(process.env.STRIPE_SECRET);

const priceIds = {
  Silver: "price_1SpiAa639JRV7b5v8XuLdpsi",   // $15
  Premium: "price_1SpiFp639JRV7b5vFrvUPG2P",  // $29.99
  Monster: "price_1SpiIH639JRV7b5vohhmcOm9"   // $59.99
};

// Tworzenie sesji checkout Stripe
router.post("/create-session", async (req, res) => {
  const { packageName, successUrl, cancelUrl } = req.body;
  if (!priceIds[packageName]) return res.status(400).json({ error: "Nieznany pakiet" });

  try {
    const session = await stripe.checkout.sessions.create({
      payment_method_types: ["card"],
      mode: "subscription",
      line_items: [{ price: priceIds[packageName], quantity: 1 }],
      success_url: successUrl,
      cancel_url: cancelUrl
    });
    res.json({ url: session.url });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;
